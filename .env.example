# Supabase PostgreSQL (Prisma)
# DATABASE_URL: 풀링 연결(transaction mode, 6543) — 런타임용
# DIRECT_URL: 마이그레이션용 직접/세션 연결(5432)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# 파일 저장 드라이버: supabase(기본, production) | local(개발/테스트 전용)
STORAGE_DRIVER=supabase

# AI Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 운영자 Access Code (실제 값은 Vercel 환경변수에만 설정)
ADMIN_ACCESS_CODE=
REVIEWER_ACCESS_CODE=

# 세션 서명용 시크릿 (32바이트 이상 랜덤 문자열)
SESSION_SECRET=
