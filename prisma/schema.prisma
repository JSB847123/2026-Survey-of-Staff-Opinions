generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  CHECKBOX
  SHORT_TEXT
  LONG_TEXT
}

model Survey {
  id             String       @id @default(cuid())
  title          String
  description    String?
  slug           String       @unique
  status         SurveyStatus @default(DRAFT)
  sourceFileName String?
  sourceFileType String?
  sourceFilePath String?
  maxRespondents Int          @default(13)
  responseCount  Int          @default(0)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  publishedAt    DateTime?

  questions  Question[]
  responses  SurveyResponse[]
  analyses   Analysis[]
  sourceFile SurveySourceFile?
}

/// 원본 설문 파일 보관 (Supabase Storage를 쓸 수 없는 환경의 fallback).
/// 파일은 500KB 이하이므로 DB 보관이 가능하며, 설문 조회 시 함께 읽히지 않도록 분리한다.
model SurveySourceFile {
  id          String   @id @default(cuid())
  surveyId    String   @unique
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

/// 앱 전역 설정 (단일 행). id는 항상 "singleton".
model AppSetting {
  id             String   @id @default("singleton")
  maxRespondents Int      @default(13)
  /// AI API 키는 평문으로 저장하지 않고 암호화해서 보관한다 (server-only에서만 복호화).
  openaiApiKeyEnc   String?
  deepseekApiKeyEnc String?
  updatedAt      DateTime @updatedAt
}

model Question {
  id          String       @id @default(cuid())
  surveyId    String
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order       Int
  type        QuestionType
  title       String
  description String?
  required    Boolean      @default(false)
  needsReview Boolean      @default(false)

  options QuestionOption[]
  answers Answer[]

  @@index([surveyId, order])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  /// '기타'처럼 선택 후 직접 입력이 필요한 선택지 (단답 20자 이내)
  allowsText Boolean  @default(false)

  selections AnswerSelection[]

  @@index([questionId, order])
}

/// 전역 응답자 계정 — 응답자가 직접 회원가입하며 전체 최대 13개까지 생성 가능
model RespondentAccount {
  id           String    @id @default(cuid())
  loginId      String    @unique
  passwordHash String
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  responses SurveyResponse[]
}

model SurveyResponse {
  id                  String            @id @default(cuid())
  surveyId            String
  survey              Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentAccountId String
  respondentAccount   RespondentAccount @relation(fields: [respondentAccountId], references: [id], onDelete: Cascade)
  submittedAt         DateTime          @default(now())

  answers Answer[]

  @@unique([surveyId, respondentAccountId])
}

model Answer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textValue  String?

  selections AnswerSelection[]

  @@unique([responseId, questionId])
}

model AnswerSelection {
  id       String         @id @default(cuid())
  answerId String
  answer   Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId String
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([answerId, optionId])
}

model Analysis {
  id             String   @id @default(cuid())
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  provider       String
  model          String
  resultJson     Json
  resultMarkdown String
  responseCount  Int
  surveyVersion  Int
  createdByRole  String
  createdAt      DateTime @default(now())

  @@index([surveyId, provider, model, surveyVersion, responseCount])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorRole  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
